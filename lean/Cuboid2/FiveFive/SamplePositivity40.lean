/-- The sample fibre `s=40` is strictly positive on all rational `y`. -/
theorem fiveFive_sample_forty_pos (y : ℚ) :
    0 < fiveFiveResultantFactor 40 y := by
  let x : ℚ := y / 10
  have hy : y = 10 * x := by
    dsimp [x]
    ring
  rw [hy, fiveFive_sample_forty_sos]
  positivity

/-- All seven sample fibres used by the pinned `5+5` replay are nonzero. -/
theorem fiveFive_all_sample_fibres_nonzero :
    (∀ y : ℚ, fiveFiveResultantFactor (1 / 100 : ℚ) y ≠ 0) ∧
    (∀ y : ℚ, fiveFiveResultantFactor (1 / 5 : ℚ) y ≠ 0) ∧
    (∀ y : ℚ, fiveFiveResultantFactor (4 / 5 : ℚ) y ≠ 0) ∧
    (∀ y : ℚ, fiveFiveResultantFactor 2 y ≠ 0) ∧
    (∀ y : ℚ, fiveFiveResultantFactor (63 / 2 : ℚ) y ≠ 0) ∧
    (∀ y : ℚ, fiveFiveResultantFactor (317 / 10 : ℚ) y ≠ 0) ∧
      ∀ y : ℚ, fiveFiveResultantFactor 40 y ≠ 0 := by
  refine ⟨?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · intro y
    exact ne_of_gt (fiveFive_sample_one_hundredth_pos y)
  · intro y
    exact ne_of_gt (fiveFive_sample_one_fifth_pos y)
  · intro y
    exact ne_of_gt (fiveFive_sample_four_fifths_pos y)
  · intro y
    exact ne_of_gt (fiveFive_sample_two_pos y)
  · intro y
    exact ne_of_gt (fiveFive_sample_sixty_three_halves_pos y)
  · intro y
    exact ne_of_gt (fiveFive_sample_three_hundred_seventeen_tenths_pos y)
  · intro y
    exact ne_of_gt (fiveFive_sample_forty_pos y)

