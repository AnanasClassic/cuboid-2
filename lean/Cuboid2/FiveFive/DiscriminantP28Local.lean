private theorem p28ThirdDerivativePower_pos {x : ℝ} (hx : 0 ≤ x) :
    0 < p28ThirdDerivativePower x := by
  unfold p28ThirdDerivativePower
  positivity

private theorem p28ThirdDerivativePower_identity (x : ℝ) :
    fiveFiveDiscriminantP28PolyReal.derivative.eval
        ((1583 / 50 : ℝ) + (1 / 100 : ℝ) * x) =
      p28ThirdDerivativePower x := by
  simp [fiveFiveDiscriminantP28PolyReal, p28ThirdDerivativePower]
  ring

private theorem unit_interval_coordinate_p28_local
    {a b t : ℝ} (hab : a < b) (hat : a ≤ t) (htb : t ≤ b) :
    ∃ x : ℝ, 0 ≤ x ∧ x ≤ 1 ∧ t = a + (b - a) * x := by
  let x : ℝ := (t - a) / (b - a)
  have hba : 0 < b - a := sub_pos.mpr hab
  refine ⟨x, ?_, ?_, ?_⟩
  · exact div_nonneg (sub_nonneg.mpr hat) hba.le
  · exact (div_le_one hba).2 (by linarith)
  · dsimp [x]
    field_simp [ne_of_gt hba]
    ring

/-- The P28 discriminant is strictly increasing on its rightmost root bracket. -/
theorem fiveFiveDiscriminantP28_derivative_pos_third
    {t : ℝ} (ht0 : 1583 / 50 ≤ t) (ht1 : t ≤ 3167 / 100) :
    0 < fiveFiveDiscriminantP28PolyReal.derivative.eval t := by
  rcases unit_interval_coordinate_p28_local
      (a := 1583 / 50) (b := 3167 / 100) (by norm_num) ht0 ht1 with
    ⟨x, hx0, hx1, ht⟩
  have hstep : (3167 / 100 : ℝ) - 1583 / 50 = 1 / 100 := by norm_num
  rw [ht, hstep, p28ThirdDerivativePower_identity]
  exact p28ThirdDerivativePower_pos hx0

/-- Strict monotonicity on the third isolating bracket. -/
theorem fiveFiveDiscriminantP28_strictMono_third :
    StrictMonoOn (fun t : ℝ => fiveFiveDiscriminantP28PolyReal.eval t)
      (Icc (1583 / 50) (3167 / 100)) := by
  apply strictMonoOn_of_deriv_pos (convex_Icc _ _)
  · exact fiveFiveDiscriminantP28PolyReal.continuous.continuousOn
  · intro t ht
    have ht' : t ∈ Icc (1583 / 50 : ℝ) (3167 / 100) := interior_subset ht
    simpa using fiveFiveDiscriminantP28_derivative_pos_third ht'.1 ht'.2

end

end Cuboid2
