/-!
# A first exact real-root isolation step for the degree-28 discriminant factor

This file moves the rightmost tiny bracket of the degree-28 discriminant
factor into Lean.  After the exact affine substitution

`u = 1583/50 + x/100`, `0 ≤ x ≤ 1`,

the derivative has an ordinary power-basis expansion with strictly positive
rational coefficients.  The expansion is checked by `ring`; positivity uses
only ordered-field reasoning.
-/

namespace Cuboid2

open Polynomial Set

noncomputable section

/-- The degree-twenty-eight discriminant factor as a polynomial over `ℝ`. -/
def fiveFiveDiscriminantP28PolyReal : ℝ[X] :=
  C 103680000 * X ^ 28 - C 7521292800 * X ^ 27 +
    C 169819194368 * X ^ 26 - C 1294911396672 * X ^ 25 +
    C 5782812799560 * X ^ 24 - C 16312796194682 * X ^ 23 +
    C 26530306841415 * X ^ 22 - C 10896270624660 * X ^ 21 -
    C 54726287337296 * X ^ 20 + C 133633789213194 * X ^ 19 -
    C 113160119424615 * X ^ 18 - C 66661996599936 * X ^ 17 +
    C 257666706220630 * X ^ 16 - C 219804850864326 * X ^ 15 -
    C 42039280815751 * X ^ 14 + C 237530759945852 * X ^ 13 -
    C 176268442531244 * X ^ 12 - C 7327917745386 * X ^ 11 +
    C 97772884071815 * X ^ 10 - C 65474588747304 * X ^ 9 +
    C 8804890164542 * X ^ 8 + C 13121572011040 * X ^ 7 -
    C 9871152051904 * X ^ 6 + C 3433840428544 * X ^ 5 -
    C 664203117056 * X ^ 4 + C 64335036416 * X ^ 3 -
    C 1308557312 * X ^ 2 - C 162529280 * X - C 2097152

