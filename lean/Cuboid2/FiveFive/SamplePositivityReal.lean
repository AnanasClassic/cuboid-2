noncomputable section

/-- Exact real SOS/LDL certificate for the `one_hundredth` sample. -/
theorem fiveFive_sample_one_hundredth_sos_real (x : ℝ) :
    fiveFiveResultantFactorReal (1 / 100 : ℝ) (30 * x) =
      43046721 * (x ^ 8) ^ 2 +
      (143245138581 / 625 : ℝ) * (x ^ 7) ^ 2 +
