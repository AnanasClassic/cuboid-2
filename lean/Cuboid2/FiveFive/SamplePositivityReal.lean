      (2629653055807025151 / 3906250000 : ℝ) * (x ^ 5) ^ 2 +
      (20687483113105268944161 / 39062500000000 : ℝ) * (x ^ 4) ^ 2 +
      (127664963923184098716861 / 488281250000000 : ℝ) * (x ^ 3) ^ 2 +
      (1932064699358681368971921 / 24414062500000000 : ℝ) * (x ^ 2) ^ 2 +
      (16405015817010529416123 / 1220703125000000 : ℝ) * x ^ 2 +
      (599089638663728299493 / 610351562500000 : ℝ) +
      (1062882 / 3125 : ℝ) * (x ^ 6 - x ^ 5) ^ 2 +
      (5305375503 / 7812500 : ℝ) * (x ^ 5 - x ^ 4) ^ 2 +
      (1531373706387 / 4882812500 : ℝ) * (x ^ 4 - x ^ 3) ^ 2 +
      (7783077006211293 / 48828125000000 : ℝ) * (x ^ 3 + x ^ 2) ^ 2 +
      (4994426797760151 / 30517578125000 : ℝ) * (x ^ 2 + x) ^ 2 +
      (104264608376367027 / 3051757812500000 : ℝ) * (x + 1) ^ 2 := by
  rw [fiveFiveResultantFactorReal_explicit]
  ring

/-- The `one_hundredth` sample fibre is positive on all real inputs. -/
theorem fiveFive_sample_one_hundredth_pos_real (y : ℝ) :
    0 < fiveFiveResultantFactorReal (1 / 100 : ℝ) y := by
  let x : ℝ := y / 30
  have hy : y = 30 * x := by
    dsimp [x]
    ring
  rw [hy, fiveFive_sample_one_hundredth_sos_real]
  positivity

