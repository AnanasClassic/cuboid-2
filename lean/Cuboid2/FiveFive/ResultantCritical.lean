    (fiveFiveResultantFactorPolyReal (s : ℝ)).eval (y : ℝ) =
      (fiveFiveResultantFactor s y : ℝ) := by
  simp [fiveFiveResultantFactorPolyReal, fiveFiveResultantFactor,

