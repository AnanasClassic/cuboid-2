/-- A critical-free positive fibre has no multiple real root. -/
theorem fiveFiveResultantFactorPolyReal_no_multiple_root
    {s : ℝ} (hs : 0 < s) (hs1 : s ≠ 1)
    (hp6 : (fiveFiveDiscriminantP6PolyReal.eval s) ≠ 0)
    (hp28 : fiveFiveDiscriminantP28PolyReal.eval s ≠ 0)
    (y : ℝ) :
    ¬ ((fiveFiveResultantFactorPolyReal s).eval y = 0 ∧
      (fiveFiveResultantFactorPolyReal s).derivative.eval y = 0) := by
  rintro ⟨hy, hy'⟩
  have hidentity := fiveFive_critical_bezout_identity s y
  rw [← eval_fiveFiveResultantFactorPolyReal, hy,
    ← eval_derivative_fiveFiveResultantFactorPolyReal, hy'] at hidentity
  rw [← eval_fiveFiveDiscriminantP6PolyReal_value,
    ← eval_fiveFiveDiscriminantP28PolyReal_value] at hidentity
  have hs0 : s ≠ 0 := ne_of_gt hs
  have hsneg : s + 1 ≠ 0 := by linarith
  have hrhs :
      274877906944 * s ^ 5 * (s - 1) ^ 10 * (s + 1) ^ 3 *
          fiveFiveDiscriminantP6PolyReal.eval s *
          (fiveFiveDiscriminantP28PolyReal.eval s) ^ 2 ≠ 0 := by
    exact
      mul_ne_zero
        (mul_ne_zero
          (mul_ne_zero
            (mul_ne_zero
              (mul_ne_zero (by norm_num) (pow_ne_zero 5 hs0))
              (pow_ne_zero 10 (sub_ne_zero.mpr hs1)))
            (pow_ne_zero 3 hsneg))
          hp6)
        (pow_ne_zero 2 hp28)
  exact hrhs (by simpa using hidentity.symm)

