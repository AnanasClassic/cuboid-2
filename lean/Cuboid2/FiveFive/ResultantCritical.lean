@[simp] theorem fiveFiveResultantFactorHomogeneousReal_at_one (s y : ℝ) :
    fiveFiveResultantFactorHomogeneousReal s y 1 =
      fiveFiveResultantFactorReal s y := by
  simp [fiveFiveResultantFactorHomogeneousReal, fiveFiveResultantFactorReal]

/-- Projective scaling agrees with affine evaluation away from infinity. -/
theorem fiveFiveResultantFactorHomogeneousReal_scale
    (s u v : ℝ) (hv : v ≠ 0) :
    fiveFiveResultantFactorHomogeneousReal s u v =
      v ^ 16 * fiveFiveResultantFactorReal s (u / v) := by
  simp only [fiveFiveResultantFactorHomogeneousReal,
    fiveFiveResultantFactorReal]
  field_simp

/-- At projective infinity only the nonzero leading coefficient remains. -/
@[simp] theorem fiveFiveResultantFactorHomogeneousReal_at_zero (s u : ℝ) :
    fiveFiveResultantFactorHomogeneousReal s u 0 = s ^ 8 * u ^ 16 := by
  simp [fiveFiveResultantFactorHomogeneousReal,
    fiveFiveResultantFactorRealCoeff16]

