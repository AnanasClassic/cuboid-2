import Cuboid2.FiveFive.DiscriminantP28Local

/-!
# Exact real-root isolation for the degree-28 `5+5` discriminant factor

The exact rational Bernstein and power-basis expansions below certify the
sign of `P28` outside three isolating brackets and the derivative sign inside
the two brackets not handled by `DiscriminantP28Local`. Every expansion is
checked by `ring`; no generated root count is trusted.
-/

namespace Cuboid2

open Polynomial Set

noncomputable section

/-- Reparameterize a closed interval by the unit segment. -/
private theorem unit_interval_coordinate_p28
    {a b t : ℝ} (hab : a < b) (hat : a ≤ t) (htb : t ≤ b) :
    ∃ x : ℝ, 0 ≤ x ∧ x ≤ 1 ∧ t = a + (b - a) * x := by
  let x : ℝ := (t - a) / (b - a)
  have hba : 0 < b - a := sub_pos.mpr hab
  refine ⟨x, ?_, ?_, ?_⟩
  · exact div_nonneg (sub_nonneg.mpr hat) hba.le
  · exact (div_le_one hba).2 (by linarith)
  · dsimp [x]
    field_simp [ne_of_gt hba]
    ring

