/-- `P28` is negative to the left of its first isolating bracket. -/
theorem fiveFiveDiscriminantP28_neg_left
    {t : ℝ} (ht0 : 0 ≤ t) (ht1 : t ≤ 47 / 100) :
    fiveFiveDiscriminantP28PolyReal.eval t < 0 := by
  rcases unit_interval_coordinate_p28
      (a := 0) (b := 47 / 100) (by norm_num) ht0 ht1 with ⟨x, hx0, hx1, ht⟩
  have ht' : t = (47 / 100 : ℝ) * x := by rw [ht]; ring
  have hpos : 0 < -(fiveFiveDiscriminantP28PolyReal.eval t) := by
    rw [ht', p28LeftBernstein_identity]
    exact p28LeftBernstein_pos hx0 hx1
  linarith

/-- `P28'` is positive on the first isolating bracket. -/
theorem fiveFiveDiscriminantP28_derivative_pos_first
    {t : ℝ} (ht0 : 47 / 100 ≤ t) (ht1 : t ≤ 471 / 1000) :
    0 < fiveFiveDiscriminantP28PolyReal.derivative.eval t := by
  rcases unit_interval_coordinate_p28
      (a := 47 / 100) (b := 471 / 1000) (by norm_num) ht0 ht1 with
    ⟨x, hx0, hx1, ht⟩
  have hstep : (471 / 1000 : ℝ) - 47 / 100 = 1 / 1000 := by norm_num
  rw [ht, hstep, p28FirstDerivativeBernstein_identity]
  exact p28FirstDerivativeBernstein_pos hx0 hx1

/-- `P28` is positive between the first bracket and `4/5`. -/
theorem fiveFiveDiscriminantP28_pos_mid_low
    {t : ℝ} (ht0 : 471 / 1000 ≤ t) (ht1 : t ≤ 4 / 5) :
    0 < fiveFiveDiscriminantP28PolyReal.eval t := by
  rcases unit_interval_coordinate_p28
      (a := 471 / 1000) (b := 4 / 5) (by norm_num) ht0 ht1 with
    ⟨x, hx0, hx1, ht⟩
  have hstep : (4 / 5 : ℝ) - 471 / 1000 = 329 / 1000 := by norm_num
  rw [ht, hstep, p28MidLowBernstein_identity]
  exact p28MidLowBernstein_pos hx0 hx1

/-- `P28` stays positive from `4/5` to the second bracket. -/
theorem fiveFiveDiscriminantP28_pos_mid_high
    {t : ℝ} (ht0 : 4 / 5 ≤ t) (ht1 : t ≤ 786 / 25) :
    0 < fiveFiveDiscriminantP28PolyReal.eval t := by
  rcases unit_interval_coordinate_p28
      (a := 4 / 5) (b := 786 / 25) (by norm_num) ht0 ht1 with
    ⟨x, hx0, hx1, ht⟩
  have hstep : (786 / 25 : ℝ) - 4 / 5 = 766 / 25 := by norm_num
  rw [ht, hstep, p28MidHighBernstein_identity]
  exact p28MidHighBernstein_pos hx0 hx1

/-- `P28'` is negative on the second isolating bracket. -/
theorem fiveFiveDiscriminantP28_derivative_neg_second
    {t : ℝ} (ht0 : 786 / 25 ≤ t) (ht1 : t ≤ 629 / 20) :
    fiveFiveDiscriminantP28PolyReal.derivative.eval t < 0 := by
  rcases unit_interval_coordinate_p28
      (a := 786 / 25) (b := 629 / 20) (by norm_num) ht0 ht1 with
    ⟨x, hx0, hx1, ht⟩
  have hstep : (629 / 20 : ℝ) - 786 / 25 = 1 / 100 := by norm_num
  have hpos : 0 < -(fiveFiveDiscriminantP28PolyReal.derivative.eval t) := by
    rw [ht, hstep, p28SecondDerivativeBernstein_identity]
    exact p28SecondDerivativeBernstein_pos hx0 hx1
  linarith

/-- `P28` is negative between its second and third brackets. -/
theorem fiveFiveDiscriminantP28_neg_between_high
    {t : ℝ} (ht0 : 629 / 20 ≤ t) (ht1 : t ≤ 1583 / 50) :
    fiveFiveDiscriminantP28PolyReal.eval t < 0 := by
  rcases unit_interval_coordinate_p28
      (a := 629 / 20) (b := 1583 / 50) (by norm_num) ht0 ht1 with
    ⟨x, hx0, hx1, ht⟩
  have hstep : (1583 / 50 : ℝ) - 629 / 20 = 21 / 100 := by norm_num
  have hpos : 0 < -(fiveFiveDiscriminantP28PolyReal.eval t) := by
    rw [ht, hstep, p28BetweenHighBernstein_identity]
    exact p28BetweenHighBernstein_pos hx0 hx1
  linarith

/-- `P28` is positive to the right of its third isolating bracket. -/
theorem fiveFiveDiscriminantP28_pos_right
    {t : ℝ} (ht : 3167 / 100 ≤ t) :
    0 < fiveFiveDiscriminantP28PolyReal.eval t := by
  let x : ℝ := t - 3167 / 100
  have hx : 0 ≤ x := by dsimp [x]; linarith
  have ht' : t = 3167 / 100 + x := by dsimp [x]; ring
  rw [ht', p28RightPower_identity]
  exact p28RightPower_pos hx

/-- `P28` is strictly increasing throughout the first isolating bracket. -/
theorem fiveFiveDiscriminantP28_strictMono_first :
    StrictMonoOn (fun t : ℝ => fiveFiveDiscriminantP28PolyReal.eval t)
      (Icc (47 / 100) (471 / 1000)) := by
  apply strictMonoOn_of_deriv_pos (convex_Icc _ _)
  · exact fiveFiveDiscriminantP28PolyReal.continuous.continuousOn
  · intro t ht
    have ht' : t ∈ Icc (47 / 100 : ℝ) (471 / 1000) := interior_subset ht
    simpa using fiveFiveDiscriminantP28_derivative_pos_first ht'.1 ht'.2

/-- `P28` is strictly decreasing throughout the second isolating bracket. -/
theorem fiveFiveDiscriminantP28_strictAnti_second :
    StrictAntiOn (fun t : ℝ => fiveFiveDiscriminantP28PolyReal.eval t)
      (Icc (786 / 25) (629 / 20)) := by
  apply strictAntiOn_of_deriv_neg (convex_Icc _ _)
  · exact fiveFiveDiscriminantP28PolyReal.continuous.continuousOn
  · intro t ht
    have ht' : t ∈ Icc (786 / 25 : ℝ) (629 / 20) := interior_subset ht
    simpa using fiveFiveDiscriminantP28_derivative_neg_second ht'.1 ht'.2

/-- The first P28 bracket contains exactly one real root. -/
theorem fiveFiveDiscriminantP28_existsUnique_first_root :
    ∃! r : ℝ,
      r ∈ Icc (47 / 100) (471 / 1000) ∧
        fiveFiveDiscriminantP28PolyReal.eval r = 0 := by
  have hleft : fiveFiveDiscriminantP28PolyReal.eval (47 / 100 : ℝ) < 0 := by
    norm_num [fiveFiveDiscriminantP28PolyReal]
  have hright : 0 <
      fiveFiveDiscriminantP28PolyReal.eval (471 / 1000 : ℝ) := by
    norm_num [fiveFiveDiscriminantP28PolyReal]
  obtain ⟨r, hr, hr0⟩ :=
    (isPreconnected_Icc.intermediate_value₂
      (show (47 / 100 : ℝ) ∈ Icc (47 / 100) (471 / 1000) by
        constructor <;> norm_num)
      (show (471 / 1000 : ℝ) ∈ Icc (47 / 100) (471 / 1000) by
        constructor <;> norm_num)
      fiveFiveDiscriminantP28PolyReal.continuous.continuousOn
      continuousOn_const hleft.le hright.le)
  refine ⟨r, ⟨hr, hr0⟩, ?_⟩
  intro z hz
  apply fiveFiveDiscriminantP28_strictMono_first.injOn hz.1 hr
  change fiveFiveDiscriminantP28PolyReal.eval z =
    fiveFiveDiscriminantP28PolyReal.eval r
  rw [hz.2, hr0]

/-- The second P28 bracket contains exactly one real root. -/
theorem fiveFiveDiscriminantP28_existsUnique_second_root :
    ∃! r : ℝ,
      r ∈ Icc (786 / 25) (629 / 20) ∧
        fiveFiveDiscriminantP28PolyReal.eval r = 0 := by
  have hleft : 0 <
      fiveFiveDiscriminantP28PolyReal.eval (786 / 25 : ℝ) := by
    norm_num [fiveFiveDiscriminantP28PolyReal]
  have hright : fiveFiveDiscriminantP28PolyReal.eval (629 / 20 : ℝ) < 0 := by
    norm_num [fiveFiveDiscriminantP28PolyReal]
  obtain ⟨r, hr, hr0⟩ :=
    (isPreconnected_Icc.intermediate_value₂
      (show (629 / 20 : ℝ) ∈ Icc (786 / 25) (629 / 20) by
        constructor <;> norm_num)
      (show (786 / 25 : ℝ) ∈ Icc (786 / 25) (629 / 20) by
        constructor <;> norm_num)
      fiveFiveDiscriminantP28PolyReal.continuous.continuousOn
      continuousOn_const hright.le hleft.le)
  refine ⟨r, ⟨hr, hr0⟩, ?_⟩
  intro z hz
  apply fiveFiveDiscriminantP28_strictAnti_second.injOn hz.1 hr
  change fiveFiveDiscriminantP28PolyReal.eval z =
    fiveFiveDiscriminantP28PolyReal.eval r
  rw [hz.2, hr0]

/-- The third P28 bracket contains exactly one real root. -/
theorem fiveFiveDiscriminantP28_existsUnique_third_root :
    ∃! r : ℝ,
      r ∈ Icc (1583 / 50) (3167 / 100) ∧
        fiveFiveDiscriminantP28PolyReal.eval r = 0 := by
  have hleft : fiveFiveDiscriminantP28PolyReal.eval (1583 / 50 : ℝ) < 0 := by
    norm_num [fiveFiveDiscriminantP28PolyReal]
  have hright : 0 <
      fiveFiveDiscriminantP28PolyReal.eval (3167 / 100 : ℝ) := by
    norm_num [fiveFiveDiscriminantP28PolyReal]
  obtain ⟨r, hr, hr0⟩ :=
    (isPreconnected_Icc.intermediate_value₂
      (show (1583 / 50 : ℝ) ∈ Icc (1583 / 50) (3167 / 100) by
        constructor <;> norm_num)
      (show (3167 / 100 : ℝ) ∈ Icc (1583 / 50) (3167 / 100) by
        constructor <;> norm_num)
      fiveFiveDiscriminantP28PolyReal.continuous.continuousOn
      continuousOn_const hleft.le hright.le)
  refine ⟨r, ⟨hr, hr0⟩, ?_⟩
  intro z hz
  apply fiveFiveDiscriminantP28_strictMono_third.injOn hz.1 hr
  change fiveFiveDiscriminantP28PolyReal.eval z =
    fiveFiveDiscriminantP28PolyReal.eval r
  rw [hz.2, hr0]

/-- Every positive P28 root lies in one of the three certified brackets. -/
theorem fiveFiveDiscriminantP28_positive_root_mem_brackets
    {r : ℝ} (hr : 0 < r)
    (hroot : fiveFiveDiscriminantP28PolyReal.eval r = 0) :
    r ∈ Icc (47 / 100) (471 / 1000) ∨
      r ∈ Icc (786 / 25) (629 / 20) ∨
        r ∈ Icc (1583 / 50) (3167 / 100) := by
  by_cases h₀ : r ≤ 47 / 100
  · exact False.elim ((ne_of_lt
      (fiveFiveDiscriminantP28_neg_left hr.le h₀)) hroot)
  by_cases h₁ : r ≤ 471 / 1000
  · exact Or.inl ⟨(lt_of_not_ge h₀).le, h₁⟩
  by_cases h₂ : r ≤ 4 / 5
  · exact False.elim ((ne_of_gt
      (fiveFiveDiscriminantP28_pos_mid_low (lt_of_not_ge h₁).le h₂)) hroot)
  by_cases h₃ : r ≤ 786 / 25
  · exact False.elim ((ne_of_gt
      (fiveFiveDiscriminantP28_pos_mid_high (lt_of_not_ge h₂).le h₃)) hroot)
  by_cases h₄ : r ≤ 629 / 20
  · exact Or.inr (Or.inl ⟨(lt_of_not_ge h₃).le, h₄⟩)
  by_cases h₅ : r ≤ 1583 / 50
  · exact False.elim ((ne_of_lt
      (fiveFiveDiscriminantP28_neg_between_high (lt_of_not_ge h₄).le h₅)) hroot)
  by_cases h₆ : r ≤ 3167 / 100
  · exact Or.inr (Or.inr ⟨(lt_of_not_ge h₅).le, h₆⟩)
  · exact False.elim ((ne_of_gt
      (fiveFiveDiscriminantP28_pos_right (lt_of_not_ge h₆).le)) hroot)

/--
`P28` has exactly three positive real roots: one in each displayed bracket
and no positive root outside their union.
-/
theorem fiveFiveDiscriminantP28_exactly_three_positive_roots :
    (∃! r : ℝ, r ∈ Icc (47 / 100) (471 / 1000) ∧
      fiveFiveDiscriminantP28PolyReal.eval r = 0) ∧
    (∃! r : ℝ, r ∈ Icc (786 / 25) (629 / 20) ∧
      fiveFiveDiscriminantP28PolyReal.eval r = 0) ∧
    (∃! r : ℝ, r ∈ Icc (1583 / 50) (3167 / 100) ∧
      fiveFiveDiscriminantP28PolyReal.eval r = 0) ∧
    ∀ r : ℝ, 0 < r → fiveFiveDiscriminantP28PolyReal.eval r = 0 →
      r ∈ Icc (47 / 100) (471 / 1000) ∨
      r ∈ Icc (786 / 25) (629 / 20) ∨
        r ∈ Icc (1583 / 50) (3167 / 100) :=
  ⟨fiveFiveDiscriminantP28_existsUnique_first_root,
    fiveFiveDiscriminantP28_existsUnique_second_root,
    fiveFiveDiscriminantP28_existsUnique_third_root,
    fun _ hr hroot => fiveFiveDiscriminantP28_positive_root_mem_brackets hr hroot⟩

end

