/-- Exact affine identity behind the left-hand Bernstein certificate. -/
private theorem p28LeftBernstein_identity (x : ℝ) :
    -(fiveFiveDiscriminantP28PolyReal.eval ((47 / 100 : ℝ) * x)) =
      p28LeftBernstein x := by
  simp [fiveFiveDiscriminantP28PolyReal, p28LeftBernstein]
  ring

/-- Exact affine identity behind the first-bracket derivative certificate. -/
