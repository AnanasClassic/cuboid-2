    fiveFiveDiscriminantP28PolyReal.derivative.eval
        ((47 / 100 : ℝ) + (1 / 1000 : ℝ) * x) =
      p28FirstDerivativeBernstein x := by
  simp [fiveFiveDiscriminantP28PolyReal, p28FirstDerivativeBernstein]
  ring

