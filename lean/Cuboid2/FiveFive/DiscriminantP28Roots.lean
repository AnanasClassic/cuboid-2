/-- Every term in the left-hand Bernstein certificate is nonnegative, with one positive. -/
private theorem p28LeftBernstein_pos
    {x : ℝ} (hx0 : 0 ≤ x) (hx1 : x ≤ 1) :
    0 < p28LeftBernstein x := by
  unfold p28LeftBernstein
  by_cases hx : x = 1
  · subst x
    norm_num
  · have hxlt : x < 1 := lt_of_le_of_ne hx1 hx
    have h1x : 0 < 1 - x := sub_pos.mpr hxlt
    positivity

