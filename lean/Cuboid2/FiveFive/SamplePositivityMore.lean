      (599360275032549430887294845201342889807603920266592256 / 91250351998433544969274142086742503967694091796875 : ℚ) * (x ^ 2 - (339877764831165425930149658290127151718761484116 / 381063000381819045313068927257120062387850392829 : ℚ) * x + (41462092264333500899766840395511870782345290836 / 381063000381819045313068927257120062387850392829 : ℚ)) ^ 2 +
      (4843610064891838791336849365357632015641295105920182494691328 / 2325823976939813508990899214215820693285219682794189453125 : ℚ) * (x - (70359871976885874866225334640759808954733009832899961 / 128311847710393237838131834807863023960359761606857048 : ℚ)) ^ 2 +
      (16191722724313481228063142221347264418130013235243317493582266368 / 97894170921625700254922359319963854950225648198590887451171875 : ℚ) := by
  unfold fiveFiveResultantFactor
  ring

/-- The sample fibre `s=4/5` is strictly positive on all rational `y`. -/
theorem fiveFive_sample_four_fifths_pos (y : ℚ) :
    0 < fiveFiveResultantFactor (4 / 5 : ℚ) y := by
  rw [fiveFive_sample_four_fifths_sos]
  positivity

