/-- The sample fibre `s=2` is strictly positive on all rational `y`. -/
theorem fiveFive_sample_two_pos (y : ℚ) :
    0 < fiveFiveResultantFactor 2 y := by
  let x : ℚ := y / 3
  have hy : y = 3 * x := by
    dsimp [x]
    ring
  rw [hy, fiveFive_sample_two_sos]
  positivity

/-- All four low and central sample fibres currently formalized are nonzero. -/
theorem fiveFive_first_four_sample_fibres_nonzero :
    (∀ y : ℚ, fiveFiveResultantFactor (1 / 100 : ℚ) y ≠ 0) ∧
    (∀ y : ℚ, fiveFiveResultantFactor (1 / 5 : ℚ) y ≠ 0) ∧
    (∀ y : ℚ, fiveFiveResultantFactor (4 / 5 : ℚ) y ≠ 0) ∧
      ∀ y : ℚ, fiveFiveResultantFactor 2 y ≠ 0 := by
  refine ⟨?_, ?_, ?_, ?_⟩
  · intro y
    exact ne_of_gt (fiveFive_sample_one_hundredth_pos y)
  · intro y
    exact ne_of_gt (fiveFive_sample_one_fifth_pos y)
  · intro y
    exact ne_of_gt (fiveFive_sample_four_fifths_pos y)
  · intro y
    exact ne_of_gt (fiveFive_sample_two_pos y)

end

end Cuboid2
