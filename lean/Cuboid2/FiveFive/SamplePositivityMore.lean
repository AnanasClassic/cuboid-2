    fiveFiveResultantFactor (4 / 5 : ℚ) x =
      (65536 / 390625 : ℚ) * (x ^ 8 - (516672 / 15625 : ℚ) * x ^ 6 + (258336 / 15625 : ℚ) * x ^ 5 + (2066688 / 15625 : ℚ) * x ^ 4 - (258336 / 3125 : ℚ) * x ^ 3 - (258336 / 3125 : ℚ) * x ^ 2 + (775008 / 15625 : ℚ) * x) ^ 2 +
