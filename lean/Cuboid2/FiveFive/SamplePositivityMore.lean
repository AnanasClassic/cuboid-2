      (18624102629559304211627733464564563968 / 3035813794320645860531463623046875 : ℚ) * (x ^ 4 - (223657840989453997005440086475776 / 284181253502797000299495444710763 : ℚ) * x ^ 3 - (99390030123974053739244434176608 / 94727084500932333433165148236921 : ℚ) * x ^ 2 + (76122726492397886740729810095264 / 94727084500932333433165148236921 : ℚ) * x - (736909519639899859655104025856 / 13532440642990333347595021176703 : ℚ)) ^ 2 +
