import Cuboid2.DPlus.CantorSemantics
import Cuboid2.DPlus.GlobalKummer

/-!
# Arbitrary rational points in the fixed `D+` Cantor presentation

The exact Cantor trace proves an identity for one stored Mumford pair.  This
file supplies the complementary source-side bridge: every rational affine
point on `D+` gives a valid degree-one Mumford pair, hence a generator in the
semantic Cantor presentation.

This is not a rank theorem.  The presentation is universal for the exact
composition and reduction certificates admitted in `DPlusCantorRelation`;
proving that it is the rational Jacobian, or that its rational point classes
are generated by `D` and `T`, remains a separate global theorem.
-/

namespace Cuboid2

open Polynomial

noncomputable section

/-- The reduced degree-one Mumford pair attached to an affine `D+` point. -/
def dplusPointMumfordPair
    (P : DPlusAffinePoint) : MumfordPair ℚ :=
  MumfordPair.ofPoint P.a P.R

/-- Every rational affine `D+` point gives a valid reduced Mumford pair. -/
theorem dplusPointMumfordPair_valid
    (P : DPlusAffinePoint) :
    (dplusPointMumfordPair P).ValidOn dplusPolynomial := by
  apply MumfordPair.ofPoint_validOn
  simpa [dplusPointMumfordPair, eval_dplusPolynomial] using P.onCurve.symm

/-- The same pair, bundled as an admissible generator of the fixed Cantor
presentation. -/
def dplusPointCantorPair
    (P : DPlusAffinePoint) : DPlusCantorPair :=
  ⟨dplusPointMumfordPair P,
    DPlusCantorAdmissible.ofValid (dplusPointMumfordPair_valid P)⟩

/-- The semantic Cantor class attached to an arbitrary rational affine
point. -/
def dplusPointCantorClass
    (P : DPlusAffinePoint) : DPlusCantorClass :=
  dplusCantorClass (dplusPointCantorPair P)

/-- The named generator pair, bundled independently of a particular
addition trace. -/
def dplusGeneratorPointCantorPair : DPlusCantorPair :=
  ⟨dplusGeneratorD,
    DPlusCantorAdmissible.ofValid dplusGeneratorD_valid⟩

/-- The named Weierstrass pair, bundled for the Cantor presentation. -/
def dplusTorsionCantorPair : DPlusCantorPair :=
  ⟨dplusTorsionT,
    DPlusCantorAdmissible.ofValid dplusTorsionT_valid⟩

/-- The known point `(1,1)` maps to the named generator pair. -/
theorem dplusPointCantorPair_onePlus :
    dplusPointCantorPair dplusOnePlus =
      dplusGeneratorPointCantorPair := by
  apply Subtype.ext
  apply MumfordPair.ext
  · rfl
  · rfl

/-- Consequently `(1,1)` maps to the named generator class. -/
@[simp] theorem dplusPointCantorClass_onePlus :
    dplusPointCantorClass dplusOnePlus =
      dplusCantorClass dplusGeneratorPointCantorPair := by
  rw [dplusPointCantorClass, dplusPointCantorPair_onePlus]

/-- The known Weierstrass point `(0,0)` maps to the named torsion pair. -/
theorem dplusPointCantorPair_zero :
    dplusPointCantorPair dplusZero =
      dplusTorsionCantorPair := by
  apply Subtype.ext
  apply MumfordPair.ext
  · rfl
  · rfl

/-- Consequently `(0,0)` maps to the named torsion class. -/
@[simp] theorem dplusPointCantorClass_zero :
    dplusPointCantorClass dplusZero =
      dplusCantorClass dplusTorsionCantorPair := by
  rw [dplusPointCantorClass, dplusPointCantorPair_zero]

/--
Any sound model of the fixed Cantor rules receives the class of every
rational affine point.  This is the exact universal consumer interface for
a future genuine divisor/Jacobian model.
-/
def DPlusCantorModel.pointClass
    {G : Type*} [AddCommGroup G]
    (model : DPlusCantorModel G)
    (P : DPlusAffinePoint) : G :=
  model.dplusCantorLift (dplusPointCantorClass P)

@[simp] theorem DPlusCantorModel.pointClass_eq_pairClass
    {G : Type*} [AddCommGroup G]
    (model : DPlusCantorModel G)
    (P : DPlusAffinePoint) :
    model.pointClass P =
      model.pairClass (dplusPointCantorPair P) := by
  exact model.dplusCantorLift_class (dplusPointCantorPair P)

end

end Cuboid2
