import Cuboid2.DPlus.Mumford

/-!
# Fixed-curve semantic Cantor classes for `D+`

This file gives a deliberately small semantic target for the exact rational
Cantor certificate.  It does not put an `Add` instance on raw Mumford pairs.
Instead it presents an abelian group whose generators are admissible
fixed-curve polynomial pairs and whose relations are admitted only by
checked Cantor composition and reduction certificates.

The presentation is useful independently of any implementation of a generic
Jacobian.  Every model of the same Mumford-equivalence rules receives a
canonical homomorphism from `DPlusCantorClass`; see `dplusCantorLift`.
-/

namespace Cuboid2

open Polynomial

noncomputable section

/--
A polynomial pair is admissible for the fixed `D+` curve when its exact
curve quotient exists.  Unlike `MumfordPair.ValidOn`, this predicate does not
impose the genus-two degree bound and therefore permits the degree-three and
degree-four semireduced pairs occurring before reduction.  Monicity and
remainder normalization are not part of this broad predicate; the generated
trace separately constructs normalized explicit polynomials.
-/
def DPlusCantorAdmissible (D : MumfordPair ℚ) : Prop :=
  ∃ q : ℚ[X], dplusPolynomial - D.v ^ 2 = D.u * q

/-- Every ordinary reduced `D+` Mumford pair is Cantor-admissible. -/
theorem DPlusCantorAdmissible.ofValid
    {D : MumfordPair ℚ} (hD : D.ValidOn dplusPolynomial) :
    DPlusCantorAdmissible D := by
  rcases hD with ⟨⟨hu, _, hv⟩, ⟨q, hq⟩⟩
  exact ⟨q, hq⟩

/-- An admissible fixed-curve pair, the generator type of the presentation. -/
abbrev DPlusCantorPair :=
  {D : MumfordPair ℚ // DPlusCantorAdmissible D}

/-- The canonical admissible neutral pair. -/
def dplusCantorInfinity : DPlusCantorPair :=
  ⟨MumfordPair.infinity,
    DPlusCantorAdmissible.ofValid
      (MumfordPair.infinity_validOn dplusPolynomial)⟩

/--
Exact coprime generalized-Cantor composition data.

The Bézout identity checks that `(u₁,u₂,v₁+v₂)` generates the unit ideal.
The following two identities are the specialized `d=1` Cantor formulas for
the support and ordinate.  All three pairs separately carry the fixed-curve
divisibility contract.
-/
structure DPlusCantorComposition
    (first second output : DPlusCantorPair) where
  bezoutFirst : ℚ[X]
  bezoutSecond : ℚ[X]
  bezoutSumV : ℚ[X]
  vQuotient : ℚ[X]
  bezout_identity :
    bezoutFirst * first.1.u + bezoutSecond * second.1.u +
        bezoutSumV * (first.1.v + second.1.v) = 1
  u_identity : output.1.u = first.1.u * second.1.u
  v_identity :
    bezoutFirst * first.1.u * second.1.v +
          bezoutSecond * second.1.u * first.1.v +
          bezoutSumV * (first.1.v * second.1.v + dplusPolynomial) =
        output.1.v + vQuotient * output.1.u

/--
Exact genus-two Cantor reduction data.

The nonzero constant `curveScale` is harmless in a principal divisor.  The
first identity factors `f-v²` into the old and new supports; the second
selects the hyperelliptically conjugate remainder, which represents the same
degree-zero divisor class.
-/
structure DPlusCantorReduction
    (input output : DPlusCantorPair) where
  curveScale : ℚ
  curveScale_ne_zero : curveScale ≠ 0
  vQuotient : ℚ[X]
  curve_identity :
    dplusPolynomial - input.1.v ^ 2 =
      C curveScale * input.1.u * output.1.u
  v_identity :
    -input.1.v = output.1.v + vQuotient * output.1.u

private abbrev DPlusCantorWord :=
  FreeAbelianGroup DPlusCantorPair

/--
The elementary fixed-curve Mumford-equivalence relations.  Composition is a
group-law relation; reduction preserves the represented class; infinity is
the neutral class.
-/
inductive DPlusCantorRelation : DPlusCantorWord → Prop
  | infinity :
      DPlusCantorRelation
        (FreeAbelianGroup.of dplusCantorInfinity)
  | composition
      {first second output : MumfordPair ℚ}
      {hfirst : DPlusCantorAdmissible first}
      {hsecond : DPlusCantorAdmissible second}
      {houtput : DPlusCantorAdmissible output}
      (certificate :
        DPlusCantorComposition ⟨first, hfirst⟩ ⟨second, hsecond⟩
          ⟨output, houtput⟩) :
      DPlusCantorRelation
        (FreeAbelianGroup.of ⟨output, houtput⟩ -
          (FreeAbelianGroup.of ⟨first, hfirst⟩ +
            FreeAbelianGroup.of ⟨second, hsecond⟩))
  | reduction
      {input output : MumfordPair ℚ}
      {hinput : DPlusCantorAdmissible input}
      {houtput : DPlusCantorAdmissible output}
      (certificate :
        DPlusCantorReduction ⟨input, hinput⟩ ⟨output, houtput⟩) :
      DPlusCantorRelation
        (FreeAbelianGroup.of ⟨output, houtput⟩ -
          FreeAbelianGroup.of ⟨input, hinput⟩)

/-- The subgroup generated by all checked fixed-curve Cantor relations. -/
def dplusCantorRelations : AddSubgroup DPlusCantorWord :=
  AddSubgroup.closure {word | DPlusCantorRelation word}

/--
The fixed-curve Cantor class presentation.  Its addition is quotient-group
addition; raw polynomial pairs themselves intentionally have no group law.
No identification with a generic Picard or Jacobian implementation is
asserted here.
-/
abbrev DPlusCantorClass :=
  DPlusCantorWord ⧸ dplusCantorRelations

/-- Send an admissible pair to its generator in the Cantor presentation. -/
def dplusCantorClass (D : DPlusCantorPair) : DPlusCantorClass :=
  QuotientAddGroup.mk' dplusCantorRelations (FreeAbelianGroup.of D)

/-- Infinity is the neutral Cantor class. -/
@[simp] theorem dplusCantorClass_infinity :
    dplusCantorClass dplusCantorInfinity = 0 := by
  unfold dplusCantorClass
  change
    (↑(FreeAbelianGroup.of dplusCantorInfinity) :
      DPlusCantorClass) = 0
  rw [QuotientAddGroup.eq_zero_iff]
  exact AddSubgroup.subset_closure DPlusCantorRelation.infinity

/-- A checked Cantor composition certificate realizes quotient addition. -/
theorem dplusCantorClass_compose
    {first second output : DPlusCantorPair}
    (certificate : DPlusCantorComposition first second output) :
    dplusCantorClass output =
      dplusCantorClass first + dplusCantorClass second := by
  apply QuotientAddGroup.eq_iff_sub_mem.mpr
  exact AddSubgroup.subset_closure
    (DPlusCantorRelation.composition certificate)

/-- A checked Cantor reduction certificate preserves the represented class. -/
theorem dplusCantorClass_reduce
    {input output : DPlusCantorPair}
    (certificate : DPlusCantorReduction input output) :
    dplusCantorClass output = dplusCantorClass input := by
  apply QuotientAddGroup.eq_iff_sub_mem.mpr
  exact AddSubgroup.subset_closure
    (DPlusCantorRelation.reduction certificate)

/-- Semantic Mumford equivalence on the fixed curve. -/
def DPlusMumfordEquivalent
    (first second : DPlusCantorPair) : Prop :=
  dplusCantorClass first = dplusCantorClass second

/-- A reduction certificate is, in particular, semantic Mumford equivalence. -/
theorem DPlusCantorReduction.equivalent
    {input output : DPlusCantorPair}
    (certificate : DPlusCantorReduction input output) :
    DPlusMumfordEquivalent output input :=
  dplusCantorClass_reduce certificate

/--
An arbitrary semantic model of the fixed-curve Cantor rules.  This is the
soundness boundary: a model must respect every exact composition, reduction,
and neutral-pair certificate, rather than merely replay a chosen trace.
-/
structure DPlusCantorModel (G : Type*) [AddCommGroup G] where
  pairClass : DPlusCantorPair → G
  infinity_eq :
    pairClass dplusCantorInfinity = 0
  composition_eq :
    ∀ {first second output : DPlusCantorPair},
      DPlusCantorComposition first second output →
        pairClass output = pairClass first + pairClass second
  reduction_eq :
    ∀ {input output : DPlusCantorPair},
      DPlusCantorReduction input output →
        pairClass output = pairClass input

namespace DPlusCantorModel

variable {G : Type*} [AddCommGroup G]

private def freeLift (model : DPlusCantorModel G) :
    DPlusCantorWord →+ G :=
  FreeAbelianGroup.lift model.pairClass

private theorem relations_le_kernel (model : DPlusCantorModel G) :
    dplusCantorRelations ≤ (freeLift model).ker := by
  unfold dplusCantorRelations
  rw [AddSubgroup.closure_le]
  intro word hword
  change DPlusCantorRelation word at hword
  cases hword with
  | infinity =>
      simpa [freeLift] using model.infinity_eq
  | composition certificate =>
      simpa [freeLift, sub_eq_add_neg] using
        sub_eq_zero.mpr (model.composition_eq certificate)
  | reduction certificate =>
      simpa [freeLift, sub_eq_add_neg] using
        sub_eq_zero.mpr (model.reduction_eq certificate)

/--
The universal soundness map from the Cantor presentation to every model of
the same exact fixed-curve Mumford-equivalence rules.
-/
def dplusCantorLift (model : DPlusCantorModel G) :
    DPlusCantorClass →+ G :=
  QuotientAddGroup.lift dplusCantorRelations
    (freeLift model) (relations_le_kernel model)

@[simp] theorem dplusCantorLift_class
    (model : DPlusCantorModel G) (D : DPlusCantorPair) :
    model.dplusCantorLift (dplusCantorClass D) = model.pairClass D := by
  simp [dplusCantorLift, dplusCantorClass, freeLift]

end DPlusCantorModel

end

end Cuboid2
