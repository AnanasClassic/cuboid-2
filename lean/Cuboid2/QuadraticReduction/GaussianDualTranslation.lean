import Cuboid2.QuadraticReduction.GaussianDescent

/-!
# Translation invariance of the normalized dual isogeny

The normalized dual map `phiHat` has kernel generated by the rational
two-torsion point `(0,0)` on the dual curve.  This module proves directly,
on Mathlib's affine point type, that translation by that point leaves
`phiHat` unchanged.
-/

namespace Cuboid2

noncomputable section

namespace GaussianDescent

private theorem gaussianRat_irreducible_fact :
    ∀ x : ℚ, x ^ 2 ≠ (-1 : ℚ) + 0 * x := by
  intro x hx
  have : 0 ≤ x ^ 2 := sq_nonneg x
  linarith

local instance : Fact (∀ x : ℚ, x ^ 2 ≠ (-1 : ℚ) + 0 * x) :=
  ⟨gaussianRat_irreducible_fact⟩

private theorem dualTorsion_addX {A B X Y : GaussianRat} (hX : X ≠ 0)
    (hXY : Y ^ 2 =
      X * (X ^ 2 - 2 * A * X + (A ^ 2 - 4 * B))) :
    (dualCurve A B).toAffine.addX 0 X
        ((dualCurve A B).toAffine.slope 0 X 0 Y) =
      (A ^ 2 - 4 * B) / X := by
  rw [WeierstrassCurve.Affine.slope_of_X_ne (Ne.symm hX)]
  simp only [dualCurve, curve, WeierstrassCurve.Affine.addX,
    zero_sub, zero_mul]
  field_simp [hX]
  rw [hXY]
  ring

private theorem dualTorsion_addY {A B X Y : GaussianRat} (hX : X ≠ 0)
    (hXY : Y ^ 2 =
      X * (X ^ 2 - 2 * A * X + (A ^ 2 - 4 * B))) :
    (dualCurve A B).toAffine.addY 0 X 0
        ((dualCurve A B).toAffine.slope 0 X 0 Y) =
      -((A ^ 2 - 4 * B) * Y / X ^ 2) := by
  rw [WeierstrassCurve.Affine.slope_of_X_ne (Ne.symm hX)]
  simp only [dualCurve, curve, WeierstrassCurve.Affine.addY,
    WeierstrassCurve.Affine.negAddY, WeierstrassCurve.Affine.negY,
    WeierstrassCurve.Affine.addX, zero_sub, zero_mul, sub_zero]
  field_simp [hX]
  rw [hXY]
  ring

/-- The dual kernel point is nonzero on the nonsingular affine curve. -/
theorem dualTorsion_ne_zero (A B : GaussianRat) (hB : B ≠ 0)
    (hC : A ^ 2 - 4 * B ≠ 0) :
    dualTorsion A B hB hC ≠ 0 := by
  simp [dualTorsion, pointOfEquation]

/-- The dual kernel point has order two. -/
theorem two_nsmul_dualTorsion (A B : GaussianRat) (hB : B ≠ 0)
    (hC : A ^ 2 - 4 * B ≠ 0) :
    2 • dualTorsion A B hB hC = 0 := by
  change
    dualTorsion A B hB hC + dualTorsion A B hB hC = 0
  have htY :
      (0 : GaussianRat) =
        (dualCurve A B).toAffine.negY 0 0 := by
    simp [dualCurve, curve]
  change
    WeierstrassCurve.Affine.Point.some 0 0 _ +
        WeierstrassCurve.Affine.Point.some 0 0 _ = 0
  exact WeierstrassCurve.Affine.Point.add_of_Y_eq rfl htY

/-- Translation by the dual kernel point does not change the normalized
dual degree-two map.
-/
theorem phiHat_dualTorsion_add (A B : GaussianRat) (hB : B ≠ 0)
    (hC : A ^ 2 - 4 * B ≠ 0)
    (Q : (dualCurve A B).toAffine.Point) :
    phiHat A B hB hC (dualTorsion A B hB hC + Q) =
      phiHat A B hB hC Q := by
  rcases Q with (_ | ⟨X, Y, h⟩)
  · change phiHat A B hB hC
        (dualTorsion A B hB hC +
          (0 : (dualCurve A B).toAffine.Point)) =
      phiHat A B hB hC 0
    rw [add_zero]
    rfl
  · have hXY : Y ^ 2 =
        X * (X ^ 2 - 2 * A * X + (A ^ 2 - 4 * B)) :=
      dualCurve_equation_iff.mp h.left
    by_cases hX : X = 0
    · have hY : Y = 0 := by
        rw [hX] at hXY
        exact sq_eq_zero_iff.mp (by simpa using hXY)
      subst X
      subst Y
      rw [show WeierstrassCurve.Affine.Point.some 0 0 h =
          dualTorsion A B hB hC by
        simp [dualTorsion, pointOfEquation]]
      rw [show dualTorsion A B hB hC +
          dualTorsion A B hB hC = 0 by
        simpa only [two_nsmul] using
          two_nsmul_dualTorsion A B hB hC]
      rfl
    · have haddX :
          (dualCurve A B).toAffine.addX 0 X
              ((dualCurve A B).toAffine.slope 0 X 0 Y) =
            (A ^ 2 - 4 * B) / X :=
        dualTorsion_addX hX hXY
      have haddY :
          (dualCurve A B).toAffine.addY 0 X 0
              ((dualCurve A B).toAffine.slope 0 X 0 Y) =
            -((A ^ 2 - 4 * B) * Y / X ^ 2) :=
        dualTorsion_addY hX hXY
      have hCX : (A ^ 2 - 4 * B) / X ≠ 0 :=
        div_ne_zero hC hX
      have hAddX :
          (dualCurve A B).toAffine.addX 0 X
              ((dualCurve A B).toAffine.slope 0 X 0 Y) ≠ 0 := by
        rw [haddX]
        exact hCX
      rw [dualTorsion, pointOfEquation,
        WeierstrassCurve.Affine.Point.add_of_X_ne (Ne.symm hX)]
      simp only [phiHat, hAddX, hX, ↓reduceDIte, pointOfEquation]
      rw [WeierstrassCurve.Affine.Point.some.injEq]
      constructor
      · rw [haddX, haddY]
        field_simp [hC, hX]
      · rw [haddX, haddY]
        field_simp [hC, hX]
        ring

end GaussianDescent

end

end Cuboid2
