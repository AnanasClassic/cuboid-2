import Cuboid2.QuadraticReduction.GaussianThreeTorsion
import Cuboid2.QuadraticReduction.GaussianMordellWeil

/-!
# Exact Gaussian torsion normal forms

This file isolates the last finite-group step after good reduction.  If every
torsion point is killed by `6`, the inert-prime exclusion of three-torsion
reduces it to the already classified two-torsion.  The finite summand in the
Mordell--Weil structure theorem is then canonically equivalent to `ZMod 2`.
-/

namespace Cuboid2
namespace GaussianTorsionNormalForm

noncomputable section

open GaussianRankArithmetic
open scoped DirectSum

set_option linter.style.haveILetI false

private theorem gaussianRat_irreducible_fact :
    ∀ x : ℚ, x ^ 2 ≠ (-1 : ℚ) + 0 * x := by
  intro x hx
  have hxnonneg : 0 ≤ x ^ 2 := sq_nonneg x
  linarith

local instance : Fact (∀ x : ℚ, x ^ 2 ≠ (-1 : ℚ) + 0 * x) :=
  ⟨gaussianRat_irreducible_fact⟩

/-- A six-torsion point is two-torsion when the group has no nonzero
three-torsion. -/
theorem eq_zero_or_eq_twoTorsion_of_six_nsmul
    {G : Type*} [AddCommGroup G]
    (T : G)
    (hTwoClassified : ∀ P : G, 2 • P = 0 → P = 0 ∨ P = T)
    (hThree : ∀ P : G, 3 • P = 0 → P = 0)
    (P : G) (hSix : 6 • P = 0) :
    P = 0 ∨ P = T := by
  apply hTwoClassified P
  apply hThree (2 • P)
  simpa only [smul_smul, Nat.reduceMul] using hSix

/-- The homomorphism from `ZMod 2` generated by a chosen point of order
dividing two. -/
def zmodTwoHom
    {D : Type*} [AddCommGroup D]
    (t : D) (ht : 2 • t = 0) :
    ZMod 2 →+ D :=
  ZMod.lift 2
    ⟨{ toFun := fun z : ℤ => z • t
       map_zero' := zero_zsmul t
       map_add' := fun a b => add_zsmul t a b },
      by
        change (2 : ℤ) • t = 0
        simpa only [two_zsmul, two_nsmul] using ht⟩

@[simp] theorem zmodTwoHom_zero
    {D : Type*} [AddCommGroup D]
    (t : D) (ht : 2 • t = 0) :
    zmodTwoHom t ht 0 = 0 :=
  map_zero _

@[simp] theorem zmodTwoHom_one
    {D : Type*} [AddCommGroup D]
    (t : D) (ht : 2 • t = 0) :
    zmodTwoHom t ht 1 = t := by
  change (1 : ℤ) • t = t
  exact one_zsmul t

/-- A finite additive group exhausted by zero and one named nonzero
two-torsion point is `ZMod 2`. -/
def finiteEquivZModTwo
    (D : Type*) [AddCommGroup D]
    (t : D) (ht : 2 • t = 0) (ht0 : t ≠ 0)
    (hclass : ∀ d : D, d = 0 ∨ d = t) :
    D ≃+ ZMod 2 := by
  let f : ZMod 2 →+ D := zmodTwoHom t ht
  have hfSurj : Function.Surjective f := by
    intro d
    rcases hclass d with hd | hd
    · exact ⟨0, by simpa only [hd] using map_zero f⟩
    · exact ⟨1, by simpa only [hd, f] using zmodTwoHom_one t ht⟩
  have hfInj : Function.Injective f := by
    intro a b hab
    fin_cases a <;> fin_cases b
    · rfl
    · change f 0 = f 1 at hab
      exact (ht0 (by
        simpa only [map_zero, f, zmodTwoHom_one] using hab.symm)).elim
    · change f 1 = f 0 at hab
      exact (ht0 (by
        simpa only [map_zero, f, zmodTwoHom_one] using hab)).elim
    · rfl
  exact (AddEquiv.ofBijective f ⟨hfInj, hfSurj⟩).symm

/-- A rank-one structure with exactly the named torsion point has the desired
normal form `ℤ × ZMod 2`. -/
def rankOneEquivZModTwo
    {G D : Type*} [AddCommGroup G] [AddCommGroup D] [Finite D]
    (e : G ≃+ ℤ × D)
    (T : G) (hT : 2 • T = 0) (hT0 : T ≠ 0)
    (hclass : ∀ P : G, IsOfFinAddOrder P → P = 0 ∨ P = T) :
    G ≃+ ℤ × ZMod 2 := by
  let t : D := (e T).2
  have hTfirst : (e T).1 = 0 := by
    have hmap := congrArg e hT
    rw [map_nsmul, map_zero] at hmap
    have hfirst := congrArg Prod.fst hmap
    norm_num [two_nsmul] at hfirst
    exact hfirst
  have hTcoord : e T = (0, t) :=
    Prod.ext hTfirst rfl
  have ht : 2 • t = 0 := by
    have hmap := congrArg e hT
    rw [map_nsmul, map_zero] at hmap
    exact congrArg Prod.snd hmap
  have ht0 : t ≠ 0 := by
    intro hz
    apply hT0
    apply e.injective
    rw [map_zero, hTcoord, hz]
    rfl
  have hclassD : ∀ d : D, d = 0 ∨ d = t := by
    intro d
    let P : G := e.symm (0, d)
    have hprod : IsOfFinAddOrder ((0 : ℤ), d) :=
      (IsOfFinAddOrder.prod_iff).mpr
        ⟨IsOfFinAddOrder.zero, isAddTorsion_of_finite d⟩
    have hP : IsOfFinAddOrder P :=
      e.symm.toAddMonoidHom.isOfFinAddOrder hprod
    rcases hclass P hP with hzero | hT'
    · left
      have h := congrArg e hzero
      have hs := congrArg Prod.snd h
      simpa [P] using hs
    · right
      have h := congrArg e hT'
      have hs := congrArg Prod.snd h
      simpa [P, hTcoord] using hs
  exact e.trans
    (AddEquiv.prodCongr (AddEquiv.refl ℤ)
      (finiteEquivZModTwo D t ht ht0 hclassD))

/-- A finite rank-zero structure with exactly the named torsion point is
`ZMod 2`. -/
def rankZeroEquivZModTwo
    {G D : Type*} [AddCommGroup G] [AddCommGroup D] [Finite D]
    (e : G ≃+ D)
    (T : G) (hT : 2 • T = 0) (hT0 : T ≠ 0)
    (hclass : ∀ P : G, IsOfFinAddOrder P → P = 0 ∨ P = T) :
    G ≃+ ZMod 2 := by
  let t : D := e T
  have ht : 2 • t = 0 := by
    simpa only [t, map_nsmul, map_zero] using congrArg e hT
  have ht0 : t ≠ 0 := by
    intro hz
    apply hT0
    apply e.injective
    simpa only [map_zero] using hz
  have hclassD : ∀ d : D, d = 0 ∨ d = t := by
    intro d
    let P : G := e.symm d
    have hP : IsOfFinAddOrder P :=
      e.symm.toAddMonoidHom.isOfFinAddOrder
        (isAddTorsion_of_finite d)
    rcases hclass P hP with hzero | hT'
    · left
      have h := congrArg e hzero
      simpa only [P, e.apply_symm_apply, map_zero] using h
    · right
      have h := congrArg e hT'
      simpa only [P, e.apply_symm_apply, t] using h
  exact e.trans (finiteEquivZModTwo D t ht ht0 hclassD)

/-! ## Actual Gaussian normal forms from a six-torsion bound -/

open GaussianMordellWeil GaussianRankArithmetic

/-- Once actual torsion on `E₀` is killed by six, the algebraic
three-torsion exclusion and the exact two-torsion classification leave only
infinity and `(0,0)`. -/
theorem gaussianE0_torsion_classified_of_six
    (hSix :
      ∀ P : gaussianE0.toAffine.Point,
        IsOfFinAddOrder P → 6 • P = 0)
    (P : gaussianE0.toAffine.Point)
    (hP : IsOfFinAddOrder P) :
    P = 0 ∨ P = gaussianE0T := by
  exact
    eq_zero_or_eq_twoTorsion_of_six_nsmul
      gaussianE0T GaussianTwoTorsion.gaussianE0_two_torsion_classified
      (fun Q hQ ↦
        (GaussianThreeTorsion.gaussianE0_three_nsmul_eq_zero_iff Q).mp hQ)
      P (hSix P hP)

/-- Once actual torsion on `E₁` is killed by six, the algebraic
three-torsion exclusion and the exact two-torsion classification leave only
infinity and `(0,0)`. -/
theorem gaussianE1_torsion_classified_of_six
    (hSix :
      ∀ P : gaussianE1.toAffine.Point,
        IsOfFinAddOrder P → 6 • P = 0)
    (P : gaussianE1.toAffine.Point)
    (hP : IsOfFinAddOrder P) :
    P = 0 ∨ P = gaussianE1T := by
  exact
    eq_zero_or_eq_twoTorsion_of_six_nsmul
      gaussianE1T GaussianTwoTorsion.gaussianE1_two_torsion_classified
      (fun Q hQ ↦
        (GaussianThreeTorsion.gaussianE1_three_nsmul_eq_zero_iff Q).mp hQ)
      P (hSix P hP)

/-- The unconditional Mordell--Weil structure of `E₀`, together with a
six-torsion bound, has exact normal form `ℤ × ZMod 2`. -/
theorem gaussianE0_equiv_of_torsion_six
    (hSix :
      ∀ P : gaussianE0.toAffine.Point,
        IsOfFinAddOrder P → 6 • P = 0) :
    Nonempty (gaussianE0.toAffine.Point ≃+ ℤ × ZMod 2) := by
  obtain ⟨ι, hι, p, hp, exponent, ⟨e⟩⟩ :=
    gaussianE0_rankOneStructure_of_fg_and_index
      gaussianE0_fg gaussianE0_doubling_index
  letI : Fintype ι := hι
  let D := ⨁ i : ι, ZMod (p i ^ exponent i)
  letI : ∀ i : ι, NeZero (p i ^ exponent i) :=
    fun i ↦ ⟨pow_ne_zero _ (hp i).ne_zero⟩
  letI : Finite D := by
    dsimp only [D]
    have : ∀ i : ι, Finite (ZMod (p i ^ exponent i)) :=
      fun _ ↦ inferInstance
    exact Finite.of_equiv _ DFinsupp.equivFunOnFintype.symm
  exact
    ⟨rankOneEquivZModTwo e gaussianE0T two_nsmul_gaussianE0T
      gaussianE0T_ne_zero (gaussianE0_torsion_classified_of_six hSix)⟩

/-- The unconditional Mordell--Weil structure of `E₁`, together with a
six-torsion bound, has exact normal form `ZMod 2`. -/
theorem gaussianE1_equiv_of_torsion_six
    (hSix :
      ∀ P : gaussianE1.toAffine.Point,
        IsOfFinAddOrder P → 6 • P = 0) :
    Nonempty (gaussianE1.toAffine.Point ≃+ ZMod 2) := by
  obtain ⟨ι, hι, p, hp, exponent, ⟨e⟩⟩ :=
    gaussianE1_rankZeroStructure_of_fg_and_index
      gaussianE1_fg gaussianE1_doubling_index
  letI : Fintype ι := hι
  let D := ⨁ i : ι, ZMod (p i ^ exponent i)
  letI : ∀ i : ι, NeZero (p i ^ exponent i) :=
    fun i ↦ ⟨pow_ne_zero _ (hp i).ne_zero⟩
  letI : Finite D := by
    dsimp only [D]
    have : ∀ i : ι, Finite (ZMod (p i ^ exponent i)) :=
      fun _ ↦ inferInstance
    exact Finite.of_equiv _ DFinsupp.equivFunOnFintype.symm
  exact
    ⟨rankZeroEquivZModTwo e gaussianE1T two_nsmul_gaussianE1T
      gaussianE1T_ne_zero (gaussianE1_torsion_classified_of_six hSix)⟩

/-- Under the same six-torsion bound, every actual `E₁` point is infinity or
the displayed point `(0,0)`.  Rank zero enters through the exact normal form,
so this conclusion applies to arbitrary points, not merely points already
known to be torsion. -/
theorem gaussianE1_point_classified_of_torsion_six
    (hSix :
      ∀ P : gaussianE1.toAffine.Point,
        IsOfFinAddOrder P → 6 • P = 0)
    (P : gaussianE1.toAffine.Point) :
    P = 0 ∨ P = gaussianE1T := by
  obtain ⟨e⟩ := gaussianE1_equiv_of_torsion_six hSix
  apply gaussianE1_torsion_classified_of_six hSix P
  rw [isOfFinAddOrder_iff_nsmul_eq_zero]
  obtain ⟨n, hn, hnP⟩ :=
    (isAddTorsion_of_finite (e P)).exists_nsmul_eq_zero
  refine ⟨n, hn, ?_⟩
  apply e.injective
  simpa only [map_nsmul, map_zero] using hnP

/-- A two-torsion bound from the two split `E₁` fibres is the strongest
special case needed by the final cover classification. -/
theorem gaussianE1_point_classified_of_torsion_two
    (hTwo :
      ∀ P : gaussianE1.toAffine.Point,
        IsOfFinAddOrder P → 2 • P = 0)
    (P : gaussianE1.toAffine.Point) :
    P = 0 ∨ P = gaussianE1T := by
  apply gaussianE1_point_classified_of_torsion_six
    (fun Q hQ ↦ ?_) P
  calc
    6 • Q = 3 • (2 • Q) := by rw [smul_smul]; norm_num
    _ = 0 := by rw [hTwo Q hQ, nsmul_zero]

end

end GaussianTorsionNormalForm
end Cuboid2
