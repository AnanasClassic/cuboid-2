import Cuboid2.QuadraticReduction.GaussianDescent

/-!
# Square completion in the Gaussian UFD

This module packages the factorization step used by the Gaussian
two-isogeny descent.  If all prime multiplicities outside two fixed Gaussian
primes are even, multiplying by at most one copy of each fixed prime produces
a square up to a Gaussian unit.
-/

namespace Cuboid2

noncomputable section

namespace GaussianUFD

open UniqueFactorizationMonoid

/-- If a nonzero Gaussian integer has even multiplicity away from two
nonassociate primes, its squareclass is generated by those primes and a unit.

The exponents are the parity corrections for the two distinguished primes.
The conclusion is an exact equality in `GaussianInt`, rather than an equality
in an abstract quotient.
-/
theorem exists_unit_mul_square_of_even_multiplicity_off_two_primes
    {r L P : GaussianInt}
    (hr : r ≠ 0)
    (hL : Prime L)
    (hP : Prime P)
    (hLP : ¬Associated L P)
    (heven : ∀ q : GaussianInt, Prime q →
      ¬Associated q L → ¬Associated q P → Even (multiplicity q r)) :
    ∃ eL eP : ℕ, eL ≤ 1 ∧ eP ≤ 1 ∧
      ∃ s : GaussianInt, ∃ u : GaussianIntˣ,
        r * L ^ eL * P ^ eP = (u : GaussianInt) * s ^ 2 := by
  classical
  letI : StrongNormalizationMonoid GaussianInt :=
    UniqueFactorizationMonoid.strongNormalizationMonoid
  let eL := multiplicity L r % 2
  let eP := multiplicity P r % 2
  let z := r * L ^ eL * P ^ eP
  have heL : eL ≤ 1 := by
    dsimp only [eL]
    omega
  have heP : eP ≤ 1 := by
    dsimp only [eP]
    omega
  have hz : z ≠ 0 :=
    mul_ne_zero (mul_ne_zero hr (pow_ne_zero eL hL.ne_zero))
      (pow_ne_zero eP hP.ne_zero)
  have hmult (q : GaussianInt) (hq : Prime q) :
      multiplicity q z =
        multiplicity q r +
          eL * multiplicity q L +
          eP * multiplicity q P := by
    dsimp only [z]
    rw [multiplicity_mul hq (FiniteMultiplicity.of_prime_left hq hz),
      multiplicity_mul hq
      (FiniteMultiplicity.of_prime_left hq
          (mul_ne_zero hr (pow_ne_zero eL hL.ne_zero))),
      (FiniteMultiplicity.of_prime_left hq hL.ne_zero).multiplicity_pow hq,
      (FiniteMultiplicity.of_prime_left hq hP.ne_zero).multiplicity_pow hq]
  have hmultEven (q : GaussianInt) (hq : Prime q) :
      Even (multiplicity q z) := by
    rw [hmult q hq]
    by_cases hqL : Associated q L
    · have hqP : ¬Associated q P := by
        intro h
        exact hLP (hqL.symm.trans h)
      have hmL : multiplicity q L = 1 := by
        rw [← multiplicity_eq_of_associated_left hqL, multiplicity_self]
      have hmP : multiplicity q P = 0 :=
        multiplicity_eq_zero.mpr <|
          (hq.dvd_prime_iff_associated hP).not.mpr hqP
      have hmr : multiplicity q r = multiplicity L r :=
        (multiplicity_eq_of_associated_left hqL).symm
      rw [hmL, hmP, hmr]
      dsimp only [eL]
      rw [Nat.even_iff]
      omega
    · by_cases hqP : Associated q P
      · have hmL : multiplicity q L = 0 :=
          multiplicity_eq_zero.mpr <|
            (hq.dvd_prime_iff_associated hL).not.mpr hqL
        have hmP : multiplicity q P = 1 := by
          rw [← multiplicity_eq_of_associated_left hqP, multiplicity_self]
        have hmr : multiplicity q r = multiplicity P r :=
          (multiplicity_eq_of_associated_left hqP).symm
        rw [hmL, hmP, hmr]
        dsimp only [eP]
        rw [Nat.even_iff]
        omega
      · have hmL : multiplicity q L = 0 :=
          multiplicity_eq_zero.mpr <|
            (hq.dvd_prime_iff_associated hL).not.mpr hqL
        have hmP : multiplicity q P = 0 :=
          multiplicity_eq_zero.mpr <|
            (hq.dvd_prime_iff_associated hP).not.mpr hqP
        rw [hmL, hmP, mul_zero, add_zero, mul_zero, add_zero]
        exact heven q hq hqL hqP
  have hcount :
      ∀ q ∈ normalizedFactors z,
        2 ∣ (normalizedFactors z).count q := by
    intro q hq
    have hqPrime : Prime q := prime_of_normalized_factor q hq
    have hqNorm : normalize q = q := normalize_normalized_factor q hq
    have hcountEq :=
      multiplicity_eq_count_normalizedFactors hqPrime.irreducible hz
    rw [hqNorm] at hcountEq
    rw [← hcountEq]
    exact even_iff_two_dvd.mp (hmultEven q hqPrime)
  obtain ⟨squareFactors, hsquareFactors⟩ :=
    Multiset.exists_smul_of_dvd_count (normalizedFactors z) hcount
  have hassociated :
      Associated (squareFactors.prod ^ 2) z := by
    have hprod := prod_normalizedFactors hz
    rw [hsquareFactors, Multiset.prod_nsmul] at hprod
    simpa using hprod
  rcases hassociated with ⟨u, hu⟩
  refine ⟨eL, eP, heL, heP, squareFactors.prod, u, ?_⟩
  simpa only [z, mul_comm] using hu.symm

end GaussianUFD

end

end Cuboid2
