import Cuboid2.QuadraticReduction.GaussianIndexIndependent
import Cuboid2.QuadraticReduction.GaussianFiniteExponent
import Cuboid2.QuadraticReduction.GaussianSplit37ReductionActual

/-!
# Index-independent paired reduction at 37

The visible point need not generate the free part.  If
`P = mG + δT` and `Q = kG + εT`, multiplication by an inverse of `m`
modulo `84` nevertheless rewrites `Q`, up to an `84`-multiple of `G`, as
an explicit row generated by `P` and `T`.  Both split reductions kill that
error term.  This is the finite-row bridge needed before the rational formal
parameter argument.
-/

namespace Cuboid2
namespace GaussianIndexIndependentReduction

noncomputable section

open GaussianFinite
open GaussianFiniteExponent
open GaussianIndexIndependent
open GaussianP37
open GaussianP37Bridge
open GaussianRankArithmetic
open GaussianProjectiveReduction
open GaussianProjectiveReductionHom
open GaussianSplit37ReductionActual

private theorem gaussianRat_irreducible_fact :
    ∀ x : ℚ, x ^ 2 ≠ (-1 : ℚ) + 0 * x := by
  intro x hx
  have hxnonneg : 0 ≤ x ^ 2 := sq_nonneg x
  linarith

local instance : Fact (∀ x : ℚ, x ^ 2 ≠ (-1 : ℚ) + 0 * x) :=
  ⟨gaussianRat_irreducible_fact⟩

/-- The parity definition of `rowTwist` is exactly the missing
two-torsion coordinate in a reindexed normal form. -/
theorem torsion_coordinate_rowTwist
    (k n : ℤ) (δ ε : ℕ) :
    (ε : ZMod 2) =
      ((k * n) : ZMod 2) * (δ : ZMod 2) +
        match rowTwist k n δ ε with
        | .plain => 0
        | .torsion => 1 := by
  by_cases hpar :
      (ε : ℤ) ≡ (k * n) * δ [ZMOD 2]
  · have hcast :
        (ε : ZMod 2) =
          (((k * n) * (δ : ℤ) : ℤ) : ZMod 2) :=
      (ZMod.intCast_eq_intCast_iff _ _ 2).2 hpar
    simp only [rowTwist, if_pos hpar]
    simpa using hcast
  · have hne :
        (ε : ZMod 2) ≠
          ((k * n) : ZMod 2) * (δ : ZMod 2) := by
      intro hcast
      apply hpar
      apply (ZMod.intCast_eq_intCast_iff _ _ 2).1
      simpa using hcast
    have hshift :
        (ε : ZMod 2) =
          ((k * n) : ZMod 2) * (δ : ZMod 2) + 1 := by
      let a : ZMod 2 := (ε : ZMod 2)
      let b : ZMod 2 := ((k * n) : ZMod 2) * (δ : ZMod 2)
      change a ≠ b at hne
      change a = b + 1
      exact
        (by native_decide +revert :
          ∀ a b : ZMod 2, a ≠ b → a = b + 1) a b hne
    simp only [rowTwist, if_neg hpar]
    exact hshift

/-- Reindexing by an inverse of `m` modulo `84` differs from the original
point by an actual integral multiple of `84G`. -/
theorem exists_row_error_multiple
    (e : GaussianIndexIndependent.E0Point ≃+ ℤ × ZMod 2)
    {Q : GaussianIndexIndependent.E0Point}
    {m k n : ℤ} {δ ε : ℕ}
    (hP :
      visiblePoint = m • freeGenerator e + δ • twoTorsionPoint)
    (hQ :
      Q = k • freeGenerator e + ε • twoTorsionPoint)
    (hinv : m * n ≡ 1 [ZMOD 84]) :
    ∃ c : ℤ,
      Q =
        globalRowPoint (k * n) (rowTwist k n δ ε) +
          c • (84 • freeGenerator e) := by
  have hd :
      (84 : ℤ) ∣ k - (k * n) * m := by
    have hbase : (84 : ℤ) ∣ 1 - m * n := by
      simpa only [sub_eq_add_neg] using hinv.dvd
    rw [show k - (k * n) * m = k * (1 - m * n) by ring]
    exact hbase.mul_left k
  obtain ⟨c, hc⟩ := hd
  have htwistImage :
      e (rowTwist k n δ ε).globalPoint =
        (0,
          match rowTwist k n δ ε with
          | .plain => 0
          | .torsion => 1) := by
    cases htwist : rowTwist k n δ ε <;>
      apply Prod.ext <;>
      simp [Twist.globalPoint, gaussianE0T_image]
  refine ⟨c, ?_⟩
  apply e.injective
  simp only [hP, hQ, globalRowPoint, map_add, map_zsmul, map_nsmul,
    freeGenerator_image, gaussianE0T_image]
  rw [htwistImage]
  apply Prod.ext
  · norm_num [zsmul_eq_mul, nsmul_eq_mul]
    linear_combination hc
  · norm_num [zsmul_eq_mul, nsmul_eq_mul]
    simpa only [Int.cast_mul] using
      torsion_coordinate_rowTwist k n δ ε

private theorem finiteMul_none
    (p A B n : ℕ) :
    finiteMul p A B none n = none := by
  induction n with
  | zero => rfl
  | succ n ih =>
      simp only [finiteMul, ih, finiteAdd]

private theorem finiteAdd_none_right
    (p A B : ℕ) (P : FinitePoint) :
    finiteAdd p A B P none = P := by
  cases P <;> rfl

/-! ## The actual split reductions kill the row-error term -/

/-- The actual plus reduction kills `84` times every selected free
generator. -/
theorem reduceE0Plus_eightyFour_nsmul_freeGenerator
    (e :
      GaussianIndexIndependent.E0Point ≃+ ℤ × ZMod 2) :
    reduceE0Plus (84 • freeGenerator e) = none := by
  have h12 :
      reduceE0Plus (12 • freeGenerator e) = none := by
    rw [map_nsmul_finite
      37 plusCoefficients.1 plusCoefficients.2
      reduceE0Plus reduceE0Plus_zero reduceE0Plus_add]
    exact plus_twelve_eq_none_of_mem
      (reduceE0Plus_mem_finitePoints (freeGenerator e))
  rw [show (84 : ℕ) = 12 * 7 by norm_num, mul_nsmul]
  rw [map_nsmul_finite
    37 plusCoefficients.1 plusCoefficients.2
    reduceE0Plus reduceE0Plus_zero reduceE0Plus_add]
  rw [h12, finiteMul_none]

/-- The actual minus reduction kills `84` times every selected free
generator. -/
theorem reduceE0Minus_eightyFour_nsmul_freeGenerator
    (e :
      GaussianIndexIndependent.E0Point ≃+ ℤ × ZMod 2) :
    reduceE0Minus (84 • freeGenerator e) = none := by
  have h42 :
      reduceE0Minus (42 • freeGenerator e) = none := by
    rw [map_nsmul_finite
      37 minusCoefficients.1 minusCoefficients.2
      reduceE0Minus reduceE0Minus_zero reduceE0Minus_add]
    exact minus_fortyTwo_eq_none_of_mem
      (reduceE0Minus_mem_finitePoints (freeGenerator e))
  rw [show (84 : ℕ) = 42 * 2 by norm_num, mul_nsmul]
  rw [map_nsmul_finite
    37 minusCoefficients.1 minusCoefficients.2
    reduceE0Minus reduceE0Minus_zero reduceE0Minus_add]
  rw [h42, finiteMul_none]

/-- Every signed multiple of the `84G` row error has trivial actual plus
reduction. -/
theorem reduceE0Plus_zsmul_eightyFour_freeGenerator
    (e :
      GaussianIndexIndependent.E0Point ≃+ ℤ × ZMod 2)
    (c : ℤ) :
    reduceE0Plus (c • (84 • freeGenerator e)) = none := by
  cases c with
  | ofNat n =>
      change reduceE0Plus (n • (84 • freeGenerator e)) = none
      rw [map_nsmul_finite
        37 plusCoefficients.1 plusCoefficients.2
        reduceE0Plus reduceE0Plus_zero reduceE0Plus_add]
      rw [reduceE0Plus_eightyFour_nsmul_freeGenerator, finiteMul_none]
  | negSucc n =>
      simp only [negSucc_zsmul, reduceE0Plus_neg]
      rw [map_nsmul_finite
        37 plusCoefficients.1 plusCoefficients.2
        reduceE0Plus reduceE0Plus_zero reduceE0Plus_add]
      rw [reduceE0Plus_eightyFour_nsmul_freeGenerator, finiteMul_none]
      rfl

/-- Every signed multiple of the `84G` row error has trivial actual minus
reduction. -/
theorem reduceE0Minus_zsmul_eightyFour_freeGenerator
    (e :
      GaussianIndexIndependent.E0Point ≃+ ℤ × ZMod 2)
    (c : ℤ) :
    reduceE0Minus (c • (84 • freeGenerator e)) = none := by
  cases c with
  | ofNat n =>
      change reduceE0Minus (n • (84 • freeGenerator e)) = none
      rw [map_nsmul_finite
        37 minusCoefficients.1 minusCoefficients.2
        reduceE0Minus reduceE0Minus_zero reduceE0Minus_add]
      rw [reduceE0Minus_eightyFour_nsmul_freeGenerator, finiteMul_none]
  | negSucc n =>
      simp only [negSucc_zsmul, reduceE0Minus_neg]
      rw [map_nsmul_finite
        37 minusCoefficients.1 minusCoefficients.2
        reduceE0Minus reduceE0Minus_zero reduceE0Minus_add]
      rw [reduceE0Minus_eightyFour_nsmul_freeGenerator, finiteMul_none]
      rfl

/-! ## Actual reindexed paired rows -/

/-- For simultaneous normal forms of the visible point and `Q`, the two
actual split reductions of `Q` are exactly the executable rows indexed by
`k * m⁻¹ (mod 84)` and the corresponding torsion twist. -/
theorem actual_reductions_eq_reindexed_rows
    (e :
      GaussianIndexIndependent.E0Point ≃+ ℤ × ZMod 2)
    {Q : GaussianIndexIndependent.E0Point}
    {m k : ℤ} {δ ε : ℕ}
    (hP :
      visiblePoint = m • freeGenerator e + δ • twoTorsionPoint)
    (hQ :
      Q = k • freeGenerator e + ε • twoTorsionPoint)
    (hm84 : IsCoprime m (84 : ℤ)) :
    reduceE0Plus Q =
        plusRowPoint
          (rowResidue k (inverseMod84 m))
          (rowTwist k (inverseMod84 m) δ ε) ∧
      reduceE0Minus Q =
        minusRowPoint
          (rowResidue k (inverseMod84 m))
          (rowTwist k (inverseMod84 m) δ ε) := by
  obtain ⟨c, herror⟩ :=
    exists_row_error_multiple e hP hQ
      (mul_inverseMod84_modEq hm84)
  constructor
  · calc
      reduceE0Plus Q =
          reduceE0Plus
            (globalRowPoint (k * inverseMod84 m)
                (rowTwist k (inverseMod84 m) δ ε) +
              c • (84 • freeGenerator e)) :=
        congrArg reduceE0Plus herror
      _ =
          finiteAdd 37 plusCoefficients.1 plusCoefficients.2
            (reduceE0Plus
              (globalRowPoint (k * inverseMod84 m)
                (rowTwist k (inverseMod84 m) δ ε)))
            (reduceE0Plus (c • (84 • freeGenerator e))) :=
        reduceE0Plus_add _ _
      _ =
          finiteAdd 37 plusCoefficients.1 plusCoefficients.2
            (plusRowPoint
              ((k * inverseMod84 m).natMod 12)
              (rowTwist k (inverseMod84 m) δ ε))
            none := by
        rw [show
          reduceE0Plus
              (globalRowPoint (k * inverseMod84 m)
                (rowTwist k (inverseMod84 m) δ ε)) =
            plusRowPoint ((k * inverseMod84 m).natMod 12)
              (rowTwist k (inverseMod84 m) δ ε) from
          split37GoodReductionActual.plus_globalRowPoint
            (k * inverseMod84 m)
            (rowTwist k (inverseMod84 m) δ ε)]
        rw [reduceE0Plus_zsmul_eightyFour_freeGenerator]
      _ =
          plusRowPoint
            (rowResidue k (inverseMod84 m))
            (rowTwist k (inverseMod84 m) δ ε) := by
        rw [finiteAdd_none_right]
        rfl
  · calc
      reduceE0Minus Q =
          reduceE0Minus
            (globalRowPoint (k * inverseMod84 m)
                (rowTwist k (inverseMod84 m) δ ε) +
              c • (84 • freeGenerator e)) :=
        congrArg reduceE0Minus herror
      _ =
          finiteAdd 37 minusCoefficients.1 minusCoefficients.2
            (reduceE0Minus
              (globalRowPoint (k * inverseMod84 m)
                (rowTwist k (inverseMod84 m) δ ε)))
            (reduceE0Minus (c • (84 • freeGenerator e))) :=
        reduceE0Minus_add _ _
      _ =
          finiteAdd 37 minusCoefficients.1 minusCoefficients.2
            (minusRowPoint
              ((k * inverseMod84 m).natMod 12)
              (rowTwist k (inverseMod84 m) δ ε))
            none := by
        rw [show
          reduceE0Minus
              (globalRowPoint (k * inverseMod84 m)
                (rowTwist k (inverseMod84 m) δ ε)) =
            minusRowPoint ((k * inverseMod84 m).natMod 12)
              (rowTwist k (inverseMod84 m) δ ε) from
          split37GoodReductionActual.minus_globalRowPoint
            (k * inverseMod84 m)
            (rowTwist k (inverseMod84 m) δ ε)]
        rw [reduceE0Minus_zsmul_eightyFour_freeGenerator]
      _ =
          minusRowPoint
            (rowResidue k (inverseMod84 m))
            (rowTwist k (inverseMod84 m) δ ε) := by
        rw [finiteAdd_none_right]
        rfl

/-- The common projective abscissa of a rational-`x` point, combined with the
actual reindexed reductions, places its coefficient and twist in the closed
paired-row classification. -/
theorem actual_reindexed_allowedRow
    (e :
      GaussianIndexIndependent.E0Point ≃+ ℤ × ZMod 2)
    {Q : GaussianIndexIndependent.E0Point}
    {m k : ℤ} {δ ε : ℕ}
    (hP :
      visiblePoint = m • freeGenerator e + δ • twoTorsionPoint)
    (hQ :
      Q = k • freeGenerator e + ε • twoTorsionPoint)
    (hm84 : IsCoprime m (84 : ℤ))
    (hxRat : HasRationalAffineX Q) :
    AllowedRow
      (rowResidue k (inverseMod84 m))
      (rowTwist k (inverseMod84 m) δ ε) := by
  have hrows :=
    actual_reductions_eq_reindexed_rows e hP hQ hm84
  have hx :=
    (split37ProjectiveReductionActual.commonX_of_rational Q hxRat).sameX
  change sameX (reduceE0Plus Q) (reduceE0Minus Q) = true at hx
  rw [hrows.1, hrows.2] at hx
  apply commonX_row_classification
    (rowResidue k (inverseMod84 m))
    (by
      unfold rowResidue
      exact Int.natMod_lt (by norm_num))
    (rowTwist k (inverseMod84 m) δ ε)
    hx

/-- For an actual `C₀` cover point, the reindexed paired rows cannot be the
infinity or two-torsion boundary rows.  Thus the twist is plain and the row
coefficient is `1` or `11` modulo `12`, without assuming that the visible
point is primitive. -/
theorem coverZero_indexIndependent_survivingRows_actual
    (e :
      GaussianIndexIndependent.E0Point ≃+ ℤ × ZMod 2)
    (C : GaussianCoverZeroPoint)
    {m k : ℤ} {δ ε : ℕ}
    (hP :
      visiblePoint = m • freeGenerator e + δ • twoTorsionPoint)
    (hC :
      C.toE0 = k • freeGenerator e + ε • twoTorsionPoint)
    (hm84 : IsCoprime m (84 : ℤ)) :
    rowTwist k (inverseMod84 m) δ ε = .plain ∧
      (rowResidue k (inverseMod84 m) = 1 ∨
        rowResidue k (inverseMod84 m) = 11) := by
  have hrows :=
    actual_reductions_eq_reindexed_rows e hP hC hm84
  have hallowed :=
    actual_reindexed_allowedRow e hP hC hm84
      (coverZero_toE0_hasRationalAffineX C)
  cases htwist :
      rowTwist k (inverseMod84 m) δ ε with
  | plain =>
      simp only [htwist, AllowedRow] at hallowed
      refine ⟨rfl, ?_⟩
      rcases hallowed with hzero | hone | heleven
      · have hplus :
            reduceE0Plus C.toE0 = none := by
          rw [hrows.1, htwist, hzero]
          native_decide
        exact
          (infinityDisk_no_square_root
            (split37CoverReductionActual.infinity_forces_leading_square
              C hplus)).elim
      · exact Or.inl hone
      · exact Or.inr heleven
  | torsion =>
      simp only [htwist, AllowedRow] at hallowed
      have hplus :
          reduceE0Plus C.toE0 = some (0, 0) := by
        rw [hrows.1, htwist, hallowed]
        native_decide
      exact
        (torsionDisk_no_square_root
          (split37CoverReductionActual.torsion_forces_q0_square
            C hplus)).elim

end

